# Copy to .env for local development. Never commit real values.
# For production (Railway), set these in the service's Variables tab; see docs/DEPLOY.md.

# Database (Supabase session pooler connection string)
DATABASE_URL=

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# App (public URL, used for links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (optional: online payments and auto-pay are disabled without these)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email via Resend (optional: emails are skipped without these)
RESEND_API_KEY=
EMAIL_FROM=

# Nightly billing
# Lets an external scheduler call /api/cron/billing (optional)
CRON_SECRET=
# Hour (0-23, UTC) after which the built-in nightly job runs. Default 9.
BILLING_JOB_HOUR_UTC=
# Set to 1 to turn the built-in scheduler off
DISABLE_BILLING_SCHEDULER=
